{
  "name": "panel-docente-android",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación Android del Panel Docente con soporte offline y transferencia ZIP",
  "scripts": {
    "prepare:android": "node scripts/prepare-android.mjs && esbuild scripts/offline-transfer-entry.js --bundle --platform=browser --format=iife --target=es2020 --outfile=www/offline-transfer.js",
    "android:sync": "npx cap sync android",
    "android:debug": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/share": "^7.0.2",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.5"
  }
}